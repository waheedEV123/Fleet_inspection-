# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server only. Never share or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: automatic email to the fleet manager (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Vehicle Inspection <inspections@yourdomain.com>

# The public address of the app, used for links in emails
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
